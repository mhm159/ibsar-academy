# ══════════════════════════════════════════
# أكاديمية إبصار — Environment Variables
# ══════════════════════════════════════════
# انسخ هذا الملف إلى .env.local وأدخل القيم الحقيقية

# ── App ──────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="أكاديمية إبصار"

# ── Database (Supabase) ───────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ── Supabase ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[SERVICE_ROLE_KEY]

# ── Auth (NextAuth) ────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=[GENERATE_WITH: openssl rand -base64 32]

# ── OTP / SMS (Twilio or Vonage) ──────────
TWILIO_ACCOUNT_SID=[SID]
TWILIO_AUTH_TOKEN=[TOKEN]
TWILIO_PHONE_NUMBER=[+201XXXXXXXXX]

# ── Payment — Kashier (مصر) ───────────────
# سجّل على: https://kashier.io
KASHIER_MERCHANT_ID=[YOUR_MERCHANT_ID]
KASHIER_SECRET_KEY=[YOUR_SECRET_KEY]
KASHIER_MODE=test  # change to 'live' in production

# ── Payment — Stripe (دولي) ───────────────
STRIPE_PUBLISHABLE_KEY=pk_test_[YOUR_KEY]
STRIPE_SECRET_KEY=sk_test_[YOUR_KEY]
STRIPE_WEBHOOK_SECRET=whsec_[YOUR_WEBHOOK_SECRET]

# ── Video — Daily.co ──────────────────────
# سجّل على: https://daily.co
DAILY_API_KEY=[YOUR_DAILY_API_KEY]
NEXT_PUBLIC_DAILY_DOMAIN=[YOUR_DOMAIN].daily.co

# ── AI — OpenAI (للتوصيات) ────────────────
OPENAI_API_KEY=sk-[YOUR_KEY]

# ── Firebase (Push Notifications) ────────
NEXT_PUBLIC_FIREBASE_API_KEY=[KEY]
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=[PROJECT].firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=[PROJECT_ID]
FIREBASE_ADMIN_SDK_KEY=[JSON_PATH]
